# ==========================================
# File Paths & Naming
# ==========================================
-o "/mnt/PAVAN/Videos/yt-dlp/%(title)s [%(id)s].%(ext)s"

# ==========================================
# Video & Audio Quality
# ==========================================
# Set max resolution to 4K (2160p) and prioritize VP9 codec
-S "res:2160,vcodec:vp9"

# Merge everything into an MKV container (best for VP9/mpv)
--merge-output-format mkv

# ==========================================
# External Downloader (aria2c)
# ==========================================
# Use aria2c for multi-threaded downloading
--downloader aria2c

# aria2c arguments:
# -c : Continue partially downloaded files
# -j 16 : Up to 16 concurrent downloads
# -x 16 : Up to 16 connections per server
# -s 16 : Split the file into 16 parts
# -k 1M : Minimum split size of 1 Megabyte
--downloader-args aria2c:"-c -j 16 -x 16 -s 16 -k 1M"

# ==========================================
# Metadata & Subtitles
# ==========================================
--embed-metadata
--embed-chapters
--embed-thumbnail
--embed-subs
--sub-langs "en.*"
--compat-options no-keep-subs

# ==========================================
# General Efficiency
# ==========================================
--no-overwrites
