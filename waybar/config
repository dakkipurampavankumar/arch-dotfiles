{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 4,
    // Choose what you want to see
    "modules-left": ["image#logo", "sway/scratchpad", "sway/window"], 
    "modules-center": ["sway/workspaces"],
    "modules-right": ["network","bluetooth","pulseaudio","cpu", "memory","custom/nightlight", "battery","tray", "clock"],

    // -- MODULE SETTINGS --

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name} {icon}",
        "format-icons": {
            "1": "", // Terminal
            "2": "", // Browser
            "3": "", // Code
            "4": "", // Media/Music
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "sway/window": {
        "show-empty" : false,
        "max-length": 100
    },
    "clock": {
        // EFFICIENT: Updates every 60 seconds instead of every second.
        "interval": 60,
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        // EFFICIENT: Updates every 10 seconds
        "interval": 2,
        "format": " {usage}%"
    },
    "memory": {
        "interval": 2,
        "format": " {}%",
	"on-click": "kitty -e htop"
    },
    "battery": {
        // EFFICIENT: Updates every 30 seconds
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // EFFICIENT: Updates every 10 seconds
        "interval": 10,
        "format-wifi": "  {essid}",
        "format-ethernet": "  Connected",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr} ",
	"on-click": "kitty -e nmtui"
    },
    "tray": {
        "spacing": 10
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": " Muted ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "kitty -e pulsemixer"
    },

    "bluetooth": {
        "format": " {status}",
        "format-disabled": " Off",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} - {device_battery_percentage}%",
        "tooltip-format": "{device_battery_percentage}%",
        "tooltip-format-connected": "{device_battery_percentage}%",
        "tooltip-format-enumerate-connected": "{device_battery_percentage}%",
        "on-click": "kitty -e bluetoothctl"
    },
    
    "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": true,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
    },

    "temperature": {
    // Points directly to the Ryzen CPU thermal sensor
    "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
    "interval" : 5,
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""],
    "tooltip": true,
    "tooltip-format": "CPU Temperature"
    },

    "custom/nightlight": {
    "format": "{icon}",
    "return-type": "json",
    "format-icons": {
        "on": "",  // Moon icon (requires FontAwesome)
        "off": ""  // Sun icon (requires FontAwesome)
    },
    "exec": "~/.config/waybar/scripts/nightlight.sh status",
    "on-click": "~/.config/waybar/scripts/nightlight.sh toggle",
    "interval": "once",
    "signal": 12
    },

    "image#logo": {
        "path": "/home/pavan/Pictures/photo.png",
        "size": 24,
        "interval": "once",
        "on-click": "kitty"
    }
}

