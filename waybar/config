{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 12,
    // Choose what you want to see
    "modules-left": ["sway/workspaces", "sway/window"], 
    "modules-center": ["clock"],
    "modules-right": ["network","bluetooth","pulseaudio","cpu", "memory", "battery","tray"],

    // -- MODULE SETTINGS --

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name} {icon}",
        "format-icons": {
            "1": "", // Terminal
            "2": "", // Browser
            "3": "", // Code
            "4": "", // Media/Music
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "sway/window": {
        "max-length": 100
    },
    "clock": {
        // EFFICIENT: Updates every 60 seconds instead of every second.
        "interval": 60,
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        // EFFICIENT: Updates every 10 seconds
        "interval": 1,
        "format": " {usage}%"
    },
    "memory": {
        "interval": 1,
        "format": " {}%",
	"on-click": "kitty -e htop"
    },
    "battery": {
        // EFFICIENT: Updates every 30 seconds
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // EFFICIENT: Updates every 10 seconds
        "interval": 10,
        "format-wifi": "  {essid}",
        "format-ethernet": "  Connected",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr} ",
	"on-click": "kitty -e nmtui"
    },
    "tray": {
        "spacing": 10
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": " Muted ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "kitty -e pulsemixer"
    },

    "bluetooth": {
        "format": " {status}",
        "format-disabled": " Off",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty -e bluetoothctl"
    }
}
