{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 4,
    // Choose what you want to see
    "modules-left": ["custom/profile", "clock", "sway/scratchpad", "sway/window"], 
    "modules-center": ["sway/workspaces"],
    "modules-right": ["network", "bluetooth", "pulseaudio", "battery", "tray"],

    // -- MODULE SETTINGS --

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "sway/window": {
        "show-empty" : false,
        "max-length": 100
    },
    "clock": {
        // EFFICIENT: Updates every 60 seconds instead of every second.
        "interval": 60,
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "⏻ AC  {capacity}%",
        "format-full": "⏻ AC",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format-discharging": "{timeTo}  •  {power:.2f}W",
        "tooltip-format-charging": "{timeTo}  •  {power:.2f}W",
        "tooltip-format-full": "On AC Power",
        "tooltip-format-plugged": "On AC Power  •  {power:.2f}W"
    },
    "network": {
        "interval": 2,
        "format-wifi": "  {essid}",
        "format-ethernet": " Connected",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format-wifi": "Signal: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
        "tooltip-format-disconnected": "No connection",
        "on-click": "footclient -e nmtui"
    },
    "tray": {
        "spacing": 10
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "Muted ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "footclient -e pulsemixer"
    },

    "bluetooth": {
        "format": " {status}",
        "format-disabled": " Off",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{status}",
        "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "• {device_alias} — {device_battery_percentage}%",
        "on-click": "footclient -e bluetoothctl"
    },
    
    "sway/scratchpad": {
    "format": " {icon}{count}",
    "show-empty": true,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
    },
    
    "custom/profile": {
        "format": " ",
        "exec": "echo '{\"tooltip\": \"Brightness: '$(brightnessctl -m | cut -d, -f4)'\"}'",
        "return-type": "json",
        "interval": 5
    }
}
