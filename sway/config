# ~/.config/sway/config

# Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $menu fuzzel

# Display Output
output * bg /home/pavan/Pictures/anime-girl-2.png fill 

# System Default Includes
include /etc/sway/config.d/*

# Modular User Includes
include ~/.config/sway/config.d/*.conf

#autostart valent service 
#exec valent --gapplication-service

exec_always autotiling

# Clipboard Manager: Start cliphist and listen to Wayland clipboard
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
