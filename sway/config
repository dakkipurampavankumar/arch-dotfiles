# ~/.config/sway/config

# Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term footclient
set $menu fuzzel

# System Default Includes
include /etc/sway/config.d/*

# Modular User Includes
include ~/.config/sway/config.d/*.conf

#autostart valent service 
#exec valent --gapplication-service

exec autotiling
xwayland disable

exec foot --server
