# ~/.config/sway/config

# Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term footclient
set $menu fuzzel

# Display Output
output * bg #000000 solid_color  
#output * bg /home/pavan/Pictures/anime-girl-2.png fill

# System Default Includes
include /etc/sway/config.d/*

# Modular User Includes
include ~/.config/sway/config.d/*.conf

#autostart valent service 
#exec valent --gapplication-service

exec_always autotiling

exec foot --server
exec foot --server
