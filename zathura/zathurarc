# Enable system clipboard for copying text (y)
set selection-clipboard clipboard

# Invert document colors (Dark mode for PDFs)
set recolor "true"

# Crucial: Prevents images from turning into weird photo negatives
set recolor-keephue "true"

# Adjust scrolling speed
set scroll-step 50

# ---------------------------------------------------------
# CATPPUCCIN MACCHIATO THEME (With Transparency)
# ---------------------------------------------------------

# The background color of the PDF pages (Fully transparent to let window bg show)
set recolor-lightcolor "rgba(36, 39, 58, 0)"

# The text/foreground color of the PDF (Macchiato Text - Soft off-white)
set recolor-darkcolor "#cad3f5"

# Match the Zathura window background to Macchiato Base with 85% opacity
set default-bg "rgba(36, 39, 58, 1)"
set default-fg "#cad3f5"

# Status bar (Matching transparent background)
set statusbar-bg "rgba(36, 39, 58, 1)"
set statusbar-fg "#cad3f5"

# Input bar (Macchiato Surface0 for slight contrast when typing commands)
set inputbar-bg "#363a4f" 
set inputbar-fg "#cad3f5"

# Notifications
set notification-bg "#363a4f"
set notification-fg "#cad3f5"
set notification-error-bg "#363a4f"
set notification-error-fg "#ed8796" # Macchiato Red
set notification-warning-bg "#363a4f"
set notification-warning-fg "#eed49f" # Macchiato Yellow

# Highlight colors for search/selection (Macchiato Peach and Red)
set highlight-color "#f5a97f"
set highlight-active-color "#ed8796"

# Command completion menu
set completion-bg "#24273a"
set completion-fg "#a5adcb" # Subtext0 for inactive completion items
set completion-highlight-bg "#363a4f"
set completion-highlight-fg "#cad3f5"
